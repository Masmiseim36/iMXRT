  <project cpu_manufacturer="NXP" cpu_name="iMXRT" description="An external GCC built executable for NXP iMXRT processor." name="iMXRT External GCC Built Executable" template_name="iMXRT_GCC_EXE" type="Executable">
    <configuration name="$(Configuration)" />
