<!DOCTYPE CrossStudio_Project_File>
<solution Name="Loader2" target="8" version="2">
  <configuration Name="MIMXRT104x_106x_FlexSPI0_NOR_API" />
  <configuration Name="MIMXRT104x_106x_FlexSPI1_NOR_API" />
  <configuration Name="MIMXRT116x_FlexSPI_NOR_API_M4" />
  <configuration Name="MIMXRT116x_FlexSPI_NOR_API_M7" />
  <configuration Name="MIMXRT117x_FlexSPI_NOR_API_M4" />
  <configuration Name="MIMXRT117x_FlexSPI_NOR_API_M7" />
  <configuration Name="MIMXRT118x_FlexSPI_NOR_API_M33" />
  <configuration Name="MIMXRT118x_FlexSPI_NOR_API_M7" />
  <project Name="FlexSPI_NOR_Loader">
    <configuration
      CMSIS_6_Core="Yes"
      Name="Common"
      Placement="TCM"
      arm_architecture="v7EM"
      arm_linker_heap_size="0"
      arm_linker_stack_size="4096"
      add_property_group_includes_defines="No"
      arm_target_interface_type="SWD"
      arm_target_loader_applicable_loaders=""
      arm_target_loader_default_loader=""
      batch_build_configurations="MIMXRT104x_106x_FlexSPI0_NOR_API;MIMXRT104x_106x_FlexSPI1_NOR_API;MIMXRT116x_FlexSPI_NOR_API_M4;MIMXRT116x_FlexSPI_NOR_API_M7;MIMXRT117x_FlexSPI_NOR_API_M4;MIMXRT117x_FlexSPI_NOR_API_M7;MIMXRT118x_FlexSPI_NOR_API_M33;MIMXRT118x_FlexSPI_NOR_API_M7"
      c_user_include_directories="$(PackagesDir)/libraries/CMSIS_6/CMSIS/Core/Include;../drivers/common;../devices/$(DeviceFamily);../devices/$(DeviceFamily)/drivers"
      gcc_debugging_level="None"
      gcc_entry_point="Reset_Handler"
      gcc_optimization_level="Level 1"
      linker_additional_files="$(StudioDir)/lib/libmem$(LibExt)$(LIB);$(StudioDir)/lib/libmem_loader$(LibExt)$(LIB)"
      linker_section_placement_file="$(StudioDir)/targets/Cortex_M/tcm_placement.xml"
      project_directory=""
      project_type="Executable"
      property_groups_file_path="$(TargetsDir)/iMXRT/propertyGroups.xml"
      target_get_partname_script=""
      target_reset_script="Reset()"
      target_script_file="$(TargetsDir)/iMXRT/iMXRT_Target.js" />
    <configuration
      Name="MIMXRT104x_106x_FlexSPI0_NOR_API"
      Target="MIMXRT1062DVL6B"
      arm_core_type="Cortex-M7"
      arm_fpu_type="FPv5-D16"
      arm_target_device_name="MIMXRT1062DVL6B"
      build_output_file_name="../Loader/MIMXRT104x_106x_FlexSPI0_NOR_API_Loader.elf"
      c_preprocessor_definitions="FlexSpiInstance=0;FLASH_START=0x60000000;CPU_MIMXRT1062DVL6B"
      c_user_include_directories="../devices/RT1060/periph;../devices/RT1060/MIMXRT1062/drivers/romapi"
      debug_register_definition_file="$(TargetsDir)/iMXRT/XML/MIMXRT1062_Registers.xml"
