	<MemorySegment name="SRAM_Alias2"    start="$(SRAMALIAS2START:0x20000000)"   size="$(SRAMAlLIAS2SIZE:0x00080000)" access="Read/Write"/>
	<MemorySegment name="SRAM_Alias3"    start="$(SRAMALIAS3START:0x30000000)"   size="$(SRAMAlLIAS3SIZE:0x00080000)" access="Read/Write"/>

	<MemorySegment name="SRAM_Cmpt"      start="$(SRAMCMPTDSTART:0x00080000)"    size="$(SRAMCMPTSIZE:0x00280000)"    access="Read/Write"/>
	<MemorySegment name="SRAM_CmpAlias1" start="$(SRAMCMPT1DSTART:0x10080000)"   size="$(SRAMCMPT1SIZE:0x00280000)"   access="Read/Write"/>
	<MemorySegment name="SRAM_CmpAlias2" start="$(SRAMCMPT2DSTART:0x20080000)"   size="$(SRAMCMPT2SIZE:0x00280000)"   access="Read/Write"/>
	<MemorySegment name="SRAM_CmpAlias3" start="$(SRAMCMPT3DSTART:0x30080000)"   size="$(SRAMCMPT3SIZE:0x00280000)"   access="Read/Write"/>
</Root> 
