<!DOCTYPE Board_Memory_Definition_File>
<Root name="iMXRT" >
<!-- This is not final - the information for this is not publicly available yet -->
	<MemorySegment name="XSPI0"          start="$(XSPI0START:0x28000000)"        size="$(XSPI0SIZE:0x08000000)"       access="ReadOnly"/>
	<MemorySegment name="XSPI1"          start="$(XSPI1START:0x08000000)"        size="$(XSPI1SIZE:0x08000000)"       access="ReadOnly"/>
	<MemorySegment name="XSPI2"          start="$(XSPI2START:0x60000000)"        size="$(XSPI2SIZE:0x08000000)"       access="ReadOnly"/>

	<MemorySegment name="SRAM"           start="$(SRAMSTART:0x00000000)"         size="$(SRAMSIZE:0x00080000)"        access="Read/Write"/>
